# ///////////////////////////////////////////////////////////////
# EXAMPLE.ENV - Template for the local, gitignored .env
# ///////////////////////////////////////////////////////////////
#
# Copy this file to `.env` at the project root and fill in the values:
#
#     copy example.env .env
#
# `.env` is gitignored and must stay that way. These are publication
# credentials: nothing here is needed to run the app, to run the tests, or
# to build it -- `uv run build.py` stays entirely local. They are read only
# by the publication helpers, `.scripts\build\publish-update.cmd` and
# `.scripts\build\publish-release.cmd`, which load this file into the
# environment before handing over to ezcompiler.
#
# Note that `ezcompiler publish ...` called directly reads the environment
# and knows nothing about a .env file: either go through the .cmd helpers,
# or export the variables yourself.
#
# Naming: do NOT rename this file to `.env.example`, which `.gitignore`
# excludes through its `.env.*` pattern -- the template would stop being
# tracked.

# ///////////////////////////////////////////////////////////////
# CLOUDFLARE R2 - the TUF update channel (publish-update)
# ///////////////////////////////////////////////////////////////
# The bucket behind [tool.ezcompiler.upload] (repo_destination = "r2"). The
# token needs write access to the bucket; the clients read the public tree
# unauthenticated, over the custom domain in repo_public_url.

# Account holding the bucket. The endpoint is derived from it:
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=

# Full endpoint URL, as an alternative to R2_ACCOUNT_ID. One of the two is
# required, and R2_ENDPOINT wins when both are set. Leave it empty unless
# the endpoint is non-standard.
R2_ENDPOINT=

# R2 API token (Object Read & Write on the bucket).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ///////////////////////////////////////////////////////////////
# GITHUB - the installer release (publish-release)
# ///////////////////////////////////////////////////////////////
# Optional. publish-release drives the `gh` CLI, so `gh auth login` is
# enough and is the preferred route. Set a token only for an unattended
# run, on a machine where gh is not logged in; it needs the `repo` scope.
GH_TOKEN=
